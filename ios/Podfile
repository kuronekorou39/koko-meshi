# 端末の下限。google_maps_flutter_ios(GoogleMaps SDK)が要求する 15.0 に合わせる。
# Runner.xcodeproj の IPHONEOS_DEPLOYMENT_TARGET と同じ値にすること
platform :ios, '15.0'

# CocoaPods の統計送信は同期処理でビルドを待たせるだけなので切る
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

# .env のAPIキーを Env.xcconfig に書き出す。
# Android(app/build.gradle.kts)が同じ .env を読んで manifestPlaceholders に渡して
# いるのと対になる仕組み。Debug/Release.xcconfig が include し、Info.plist の
# $(GOOGLE_MAPS_API_KEY) に展開されて AppDelegate が読む。
# 生成物はキーを含むのでコミットしない(ios/.gitignore)。
def generate_env_xcconfig
  ios_dir = File.dirname(File.realpath(__FILE__))
  env_file = File.expand_path(File.join(ios_dir, '..', '.env'))
  values = {}
  if File.exist?(env_file)
    File.foreach(env_file) do |line|
      trimmed = line.strip
      next if trimmed.empty? || trimmed.start_with?('#') || !trimmed.include?('=')
      key, value = trimmed.split('=', 2)
      values[key.strip] = value.strip
    end
  else
    puts '警告: .env が見つかりません。地図が表示されない状態でビルドされます'
  end
  # 地図のキーはiOS用を使う。Googleのキー制限は「Androidアプリ」と「iOSアプリ」を
  # 同時に指定できないので、Androidと同じキーは使い回せない。
  # 未設定ならAndroid用に落とす(制限をかけていないキーならそれでも動く)
  raw_key = values['GOOGLE_MAPS_API_KEY_IOS']
  raw_key = values['GOOGLE_MAPS_API_KEY'] if raw_key.nil? || raw_key.empty?
  # xcconfig は // 以降をコメントとして捨てる。APIキーには現れない並びだが、
  # 混ざったときに黙って壊れないよう落としておく
  api_key = (raw_key || '').gsub('//', '')
  File.write(File.join(ios_dir, 'Flutter', 'Env.xcconfig'), "GOOGLE_MAPS_API_KEY=#{api_key}\n")
end

generate_env_xcconfig

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # GoogleMaps SDK が動的フレームワークで配布されているため必要
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Pod 側の既定の下限がアプリより古いと警告が大量に出るので揃える
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
