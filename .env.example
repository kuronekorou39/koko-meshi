# 地図表示(Maps SDK for Android)用。build.gradle.kts が読んで
# AndroidManifest の com.google.android.geo.API_KEY へ渡す。
# Androidアプリ制限(パッケージ名+SHA-1)をかけること
GOOGLE_MAPS_API_KEY=ここにAPIキーを入力

# 地図表示(Maps SDK for iOS)用。iOSアプリ制限(バンドルID)をかけること。
# ※ まだ未配線。iOS対応時に AppDelegate の GMSServices.provideAPIKey へ
#    渡す仕組みが要る(Dartの.envはSwiftから読めないため xcconfig 経由)
GOOGLE_MAPS_API_KEY_IOS=

# 場所検索(Places API (New))用。Android/iOS 共用。
#
# アプリ制限はかけない。http パッケージからの直接呼び出しは
# X-Android-Package / X-Ios-Bundle-Identifier ヘッダを送らないため、
# 制限をかけると検索が動かなくなる。API制限と割り当て上限で守る。
# 空なら GOOGLE_MAPS_API_KEY を使う
GOOGLE_PLACES_API_KEY=
