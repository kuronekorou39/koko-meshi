# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# 環境変数
.env

# Claude Code のローカル許可リスト。実行したコマンドがそのまま溜まるので、
# APIキーを含む curl などを許可すると値ごと残る。ローカル設定なので追跡しない
.claude/settings.local.json

# Android release keystore
android/app/*.keystore
android/key.properties

# リリースビルドの成果物(アプリ名+バージョンでリポジトリ直下に置くため)
*.apk

# アイコンの確認用(tool/make_app_icon.py --preview / --preview-scale で再生成できる)
assets/icon/preview-background.png
assets/icon/preview-scale.png
